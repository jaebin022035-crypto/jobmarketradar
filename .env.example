# JobMarketRadar 환경변수 (복사해서 .env 로 만들고 실제값 채우기)
# ⚠️ .env 는 절대 git 에 커밋 금지 (.gitignore 에 포함됨)

# 국민취업지원제도 채용정보 API 인증키 (공공데이터포털에서 발급)
DHS_API_KEY=여기에_발급받은_인증키

# [Step 7] 이력서 관리 - 자기소개서 AI 생성용 Gemini API 키
# 발급: https://aistudio.google.com/apikey (구글 계정)
# 무료 할당량 충분(분당 15회/일일 150만 토큰). 미설정 시 자소서 AI 생성 기능만 503 에러.
# 엔진 교체(Ollama/OpenAI 등) 시 docs/step7-resume-ai.md 참고.
GEMINI_API_KEY=

# [Step 9] AI 모델 2단 구조 — 변경 방법/지원 모델 목록: docs/ai-model-config.md
#   PIPE(정제·파이핑) / QUALITY(분석·자소서 생성)
# GEMINI_MODEL_PIPE=gemini-3.5-flash-lite
# GEMINI_MODEL_QUALITY=gemini-3.5-flash
# GEMINI_MODEL=gemini-2.5-flash   # (구 Step 7 호환 — QUALITY 우선순위에서만 적용)

# API 엔드포인트 — 고용24 직접 호출 (2026-07-07 검증 완료)
#   목록(L): https://www.work24.go.kr/cm/openApi/call/wk/callOpenApiSvcInfo210L21.do
#   상세(D): https://www.work24.go.kr/cm/openApi/call/wk/callOpenApiSvcInfo210D21.do
# (엔드포인트는 collector.js 상수로 고정. 변경 필요시에만 아래 주석 해제)
# DHS_API_HOST=https://www.work24.go.kr/cm/openApi/call/wk

# Express 서버 포트
PORT=3000

# 수집 주기(cron) - 기본 1일 2회 (오전9시/오후9시)
# CRON_SCHEDULE=0 9,21 * * *
